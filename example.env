# .env file used by load_dotenv to insert environment variables in the jupyter environment
# copy example.env to .env

# Required for research agents with external search (Google Serper)
SERPER_API_KEY=your_serper_api_key_here

# LLM provider settings (anthropic or openai)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: OpenAI model usage
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: SSL configuration (set to false if behind a corporate proxy/firewall)
SSL_VERIFY=true

# Optional: For evaluation and tracing (LangSmith)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=DeepAgent